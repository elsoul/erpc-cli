#!/usr/sbin/nft -f
# Managed by erpc: the Ethereum RPC node's firewall, a table of its own that
# is replaced whole. Inbound is dropped unless listed here; outbound is open.
# Other tables on the host are left as they are, and a packet any of them
# drops stays dropped.

table inet erpc_eth
delete table inet erpc_eth

table inet erpc_eth {
  set management_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if eth_fw_management_v4 | length > 0 %}
    elements = { {{ eth_fw_management_v4 | join(', ') }} }
{% endif %}
  }

  set management_v6 {
    type ipv6_addr
    flags interval
    auto-merge
{% if eth_fw_management_v6 | length > 0 %}
    elements = { {{ eth_fw_management_v6 | join(', ') }} }
{% endif %}
  }

  set rpc_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if eth_rpc_allow | length > 0 %}
    elements = { {{ eth_rpc_allow | join(', ') }} }
{% endif %}
  }

  set monitoring_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if eth_monitoring_allow | length > 0 %}
    elements = { {{ eth_monitoring_allow | join(', ') }} }
{% endif %}
  }

  chain input {
    type filter hook input priority 0
    policy drop

    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    tcp dport {{ eth_ssh_port }} ip saddr @management_v4 accept
    tcp dport {{ eth_ssh_port }} ip6 saddr @management_v6 accept

    tcp dport { 8545, 8546 } ip saddr @rpc_v4 accept
    # Reth's and Lighthouse's metrics.
    tcp dport { 9002, 5054 } ip saddr @monitoring_v4 accept

    # Peer-to-peer, open to all: Reth on 30303 (and discv5 on 9200),
    # Lighthouse on 9000 (and QUIC on 9001).
    tcp dport { 30303, 9000 } accept
    udp dport { 30303, 9200, 9000, 9001 } accept

    counter drop
  }
}
