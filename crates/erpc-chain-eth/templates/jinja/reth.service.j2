# Managed by erpc: `erpc r --chain eth update-config` writes it again.
[Unit]
Description=Reth, the execution layer ({{ eth_rpc_type }}, {{ eth_reth_version }})
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ eth_jwt }}

Requires=erpc-eth-firewall.service

[Service]
ExecStartPre=+/usr/bin/python3 /usr/local/lib/erpc/rpc-firewall.py eth guard
Type=simple
User=reth
Group=ethereum
UMask=0027
WorkingDirectory={{ eth_reth_dir }}
# The prune config of a full node is in {{ eth_reth_dir }}/reth.toml, which
# reth download wrote; --full says the same.
ExecStart={{ eth_opt }}/current/reth --color never --log.file.max-files 0 node \
  --chain mainnet \
  --datadir {{ eth_reth_dir }} \
{% if eth_full | bool %}
  --full \
{% endif %}
  --addr 0.0.0.0 \
  --port 30303 \
  --discovery.port 30303 \
  --discovery.v5.port 9200 \
  --http \
  --http.addr {{ eth_rpc_bind }} \
  --http.port 8545 \
  --http.api {{ eth_rpc_api }} \
  --ws \
  --ws.addr {{ eth_rpc_bind }} \
  --ws.port 8546 \
  --ws.api {{ eth_rpc_api }} \
  --ipcdisable \
  --authrpc.addr 127.0.0.1 \
  --authrpc.port 8551 \
  --authrpc.jwtsecret {{ eth_jwt }} \
  --metrics {{ eth_metrics_bind }}:9002

Restart=always
RestartSec=10
KillSignal=SIGINT
# A clean stop ends with the signal's exit status, not 0.
SuccessExitStatus=130 143 SIGINT SIGTERM
TimeoutStopSec=300
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reth

ReadWritePaths={{ eth_reth_dir }}
ReadOnlyPaths={{ eth_opt }} /etc/ethereum
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
