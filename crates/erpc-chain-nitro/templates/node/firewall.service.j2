[Unit]
Description=ERPC {{ nitro_family }} confirmed firewall
DefaultDependencies=no
After=nftables.service
Before=network-pre.target shutdown.target erpc-{{ nitro_family }}-nitro.service erpc-{{ nitro_family }}-upstreams.service
Wants=network-pre.target
Conflicts=shutdown.target
RequiresMountsFor=/opt/erpc /etc/erpc/{{ nitro_family }}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /usr/local/lib/erpc/rpc-firewall.py {{ nitro_family }} load

[Install]
WantedBy=multi-user.target
