[Unit]
Description=ERPC original Robinhood testnet Defensive validator bounded parent transport
Requires=erpc-robinhood-firewall.service
After=network-online.target erpc-robinhood-firewall.service
Wants=network-online.target

[Service]
Type=exec
User=0
Group=0
UMask=0077
LimitCORE=0
LoadCredentialEncrypted=robinhood-testnet-defensive-upstreams:/etc/credstore.encrypted/robinhood-testnet-validator-l1/upstreams.cred
LoadCredentialEncrypted=robinhood-testnet-defensive-parent-tls:/etc/credstore.encrypted/robinhood-testnet-validator-tls/parent-tls.cred
ExecCondition={{ validator_condition_command }} runtime-condition transport
ExecStartPre={{ validator_runtime_command }} runtime-prepare transport
ExecStart={{ validator_runtime_command }} runtime-run transport
ExecStartPost={{ validator_runtime_command }} runtime-ready transport
ExecStop={{ validator_runtime_command }} runtime-stop transport
TimeoutStartSec=120
TimeoutStopSec=120
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/erpc-robinhood-testnet-validator /run/erpc-robinhood-testnet-validator
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
