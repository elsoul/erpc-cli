[Unit]
Description=ERPC original Arbitrum validator bounded parent transport
Requires=erpc-arbitrum-firewall.service
After=network-online.target erpc-arbitrum-firewall.service
Wants=network-online.target

[Service]
Type=exec
User=0
Group=0
UMask=0077
LimitCORE=0
LoadCredentialEncrypted=arbitrum-upstreams:/etc/credstore.encrypted/arbitrum-validator-l1/upstreams.cred
LoadCredentialEncrypted=arbitrum-parent-tls:/etc/credstore.encrypted/arbitrum-validator-tls/parent-tls.cred
ExecCondition={{ validator_condition_command }} runtime-condition transport
ExecStartPre={{ validator_runtime_command }} runtime-prepare transport
ExecStart={{ validator_runtime_command }} runtime-run transport
ExecStartPost={{ validator_runtime_command }} runtime-ready transport
ExecStop={{ validator_runtime_command }} runtime-stop transport
TimeoutStartSec=120
TimeoutStopSec=120
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/erpc-nitro /run/erpc-arbitrum-validator
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
