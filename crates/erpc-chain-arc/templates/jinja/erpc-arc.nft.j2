#!/usr/sbin/nft -f
# Managed by erpc: the Arc RPC node's firewall, a table of its own that is
# replaced whole. Inbound is dropped unless listed here; outbound is open.
# Other tables on the host are left as they are, and a packet any of them
# drops stays dropped.

table inet erpc_arc
delete table inet erpc_arc

table inet erpc_arc {
  set management_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if arc_fw_management_v4 | length > 0 %}
    elements = { {{ arc_fw_management_v4 | join(', ') }} }
{% endif %}
  }

  set management_v6 {
    type ipv6_addr
    flags interval
    auto-merge
{% if arc_fw_management_v6 | length > 0 %}
    elements = { {{ arc_fw_management_v6 | join(', ') }} }
{% endif %}
  }

  set rpc_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if arc_rpc_allow | length > 0 %}
    elements = { {{ arc_rpc_allow | join(', ') }} }
{% endif %}
  }

  set monitoring_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if arc_monitoring_allow | length > 0 %}
    elements = { {{ arc_monitoring_allow | join(', ') }} }
{% endif %}
  }

  set sentry_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if arc_sentry_addresses | default([]) | length > 0 %}
    elements = { {{ arc_sentry_addresses | join(', ') }} }
{% endif %}
  }

  chain input {
    type filter hook input priority 0
    policy drop

    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    tcp dport {{ arc_ssh_port }} ip saddr @management_v4 accept
    tcp dport {{ arc_ssh_port }} ip6 saddr @management_v6 accept

    tcp dport { 8545, 8546 } ip saddr @rpc_v4 accept
    tcp dport { 9001, 29000 } ip saddr @monitoring_v4 accept
{% if arc_provider | bool %}

    # A provider node: execution-layer gossip is open to all, consensus
    # peering only to Arc's sentries.
    meta l4proto { tcp, udp } th dport 30303 accept
    tcp dport 27000 ip saddr @sentry_v4 accept
{% endif %}

    counter drop
  }
}
