# Managed by erpc: `erpc r --chain arc update-config` writes it again.
[Unit]
Description=Arc consensus layer ({{ arc_chain }}, {{ arc_version }})
After=arc-execution.service
Requires=arc-execution.service

Requires=erpc-arc-firewall.service

[Service]
ExecStartPre=+/usr/bin/python3 -I /usr/local/lib/erpc/rpc-firewall.py arc guard
Type=simple
User=arc
Group=arc
Environment=RUST_LOG=info
WorkingDirectory={{ arc_home }}
# The consensus key is kept encrypted by systemd-creds; systemd decrypts it
# into this service's own in-memory credentials directory (%d) at start.
LoadCredentialEncrypted=consensus-key:{{ arc_credential }}
ExecStart={{ arc_opt }}/current/arc-node-consensus start \
  --home {{ arc_home }}/consensus \
  --private-key %d/consensus-key \
{% if arc_pruned | bool %}
  --full \
{% endif %}
  --eth-socket /run/arc/reth.ipc \
  --execution-socket /run/arc/auth.ipc \
  --rpc.addr 127.0.0.1:31000 \
{% if arc_provider | bool %}
  --p2p.persistent-peers {{ arc_sentry_peers | join(',') }} \
  --p2p.persistent-peers-only \
  --no-consensus \
{% else %}
  --follow \
{% for endpoint in arc_follow %}
  --follow.endpoint {{ endpoint }} \
{% endfor %}
{% endif %}
  --execution-persistence-backpressure \
  --execution-persistence-backpressure-threshold={{ arc_backpressure_threshold }} \
  --metrics {{ arc_metrics_bind }}:29000

Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=300
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arc-consensus

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ arc_home }} -/run/arc
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
