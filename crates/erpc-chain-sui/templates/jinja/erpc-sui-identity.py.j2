"""Create one host-bound encrypted P2P identity; refuse loss after initialization."""
import base64
import os
import pathlib
import subprocess
import sys
import tempfile


def main():
    if os.name == 'posix':
        import resource
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    if len(sys.argv) != 4:
        raise SystemExit('identity requires an expected host contract')
    subprocess.run(['/usr/bin/python3', '-I', '/usr/local/lib/erpc/sui/erpc-sui-control.py', 'guard-account', *sys.argv[1:]], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    credential = pathlib.Path('/etc/credstore.encrypted/sui-network.key')
    marker = pathlib.Path('/etc/sui/identity-established')
    if credential.exists():
        # Check decryption without emitting the key. Interrupted marker writes recover here.
        subprocess.run(['systemd-creds', 'decrypt', '--name=network.key', str(credential), '-'],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        marker.touch(mode=0o600)
        return
    if marker.exists() or pathlib.Path('/var/lib/sui/db/live').exists():
        raise SystemExit('Sui identity is missing; restore the original credential, never regenerate')
    with tempfile.TemporaryDirectory(prefix='.identity-', dir='/etc/sui') as directory:
        # SuiKeyPair file: Ed25519 scheme byte followed by a 32-byte CSPRNG seed.
        # No account funds or mnemonic are created; this is only peer identity.
        key = pathlib.Path(directory) / 'network.key'
        key.write_bytes(base64.b64encode(bytes([0]) + os.urandom(32)))
        pending = credential.with_suffix('.pending')
        subprocess.run(['systemd-creds', 'encrypt', '--name=network.key', str(key), str(pending)],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.chmod(pending, 0o600)
        os.replace(pending, credential)
        marker.touch(mode=0o600)


if __name__ == '__main__':
    main()
