[Unit]
Description=ERPC restricted Avalanche API gateway
After=avalanchego.service erpc-avax-firewall.service
Requires=avalanchego.service
[Service]
User={{ avax_runtime_account.uid }}
Group={{ avax_runtime_account.gid }}
SupplementaryGroups=
DynamicUser=no
LimitCORE=0
ExecCondition=+{{ avax_control_condition }} gateway-condition
RuntimeDirectory=avax-proxy
ExecStartPre=/usr/sbin/nginx -t -c /etc/avalanchego/proxy.conf
ExecStart=/usr/sbin/nginx -c /etc/avalanchego/proxy.conf -g "daemon off;"
KillMode=control-group
SendSIGKILL=no
TimeoutStopSec=180
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/avax-proxy
[Install]
WantedBy=multi-user.target
