#!/usr/sbin/nft -f
# Managed by erpc: the Avalanche RPC node's firewall, a table of its own that
# is replaced whole. Inbound is dropped unless listed here; outbound is open.
# Other tables on the host are left as they are, and a packet any of them
# drops stays dropped.

table inet erpc_avax
delete table inet erpc_avax

table inet erpc_avax {
  set management_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if avax_fw_management_v4 | length > 0 %}
    elements = { {{ avax_fw_management_v4 | join(', ') }} }
{% endif %}
  }

  set management_v6 {
    type ipv6_addr
    flags interval
    auto-merge
{% if avax_fw_management_v6 | length > 0 %}
    elements = { {{ avax_fw_management_v6 | join(', ') }} }
{% endif %}
  }

  set rpc_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if avax_rpc_allow | length > 0 %}
    elements = { {{ avax_rpc_allow | join(', ') }} }
{% endif %}
  }

  set monitoring_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if avax_monitoring_allow | length > 0 %}
    elements = { {{ avax_monitoring_allow | join(', ') }} }
{% endif %}
  }

  chain input {
    type filter hook input priority 0
    policy drop

    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    tcp dport {{ avax_ssh_port }} ip saddr @management_v4 accept
    tcp dport {{ avax_ssh_port }} ip6 saddr @management_v6 accept

    tcp dport 9652 ip saddr @rpc_v4 accept
    tcp dport 9653 ip saddr @monitoring_v4 accept
    tcp dport 9651 accept

    counter drop
  }
}
