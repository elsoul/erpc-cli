[Unit]
Description=Confirmed Avalanche firewall
After=network-pre.target
Before=avalanchego.service avalanche-rpc.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ avax_control_unit }} firewall-load
# Keep filtering on stop; rollback has its own operation-checked controller.
[Install]
WantedBy=multi-user.target
