pid /run/avax-proxy/nginx.pid;
error_log stderr warn;
events { worker_connections 4096; }
http {
  access_log off;
  client_body_temp_path /run/avax-proxy/body;
  proxy_temp_path /run/avax-proxy/proxy;
  fastcgi_temp_path /run/avax-proxy/fastcgi;
  scgi_temp_path /run/avax-proxy/scgi;
  uwsgi_temp_path /run/avax-proxy/uwsgi;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen {{ '0.0.0.0' if avax_rpc_allow | length > 0 else '127.0.0.1' }}:9652;
    allow 127.0.0.1;
{% for cidr in avax_rpc_allow %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    client_max_body_size 4m;
    location ~ ^/ext/(bc/(C/(rpc|ws)|P|X)|info|health)$ {
      proxy_pass http://127.0.0.1:9650;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host localhost;
    }
    location / { return 403; }
  }
  server {
    listen {{ '0.0.0.0' if avax_monitoring_allow | length > 0 else '127.0.0.1' }}:9653;
    allow 127.0.0.1;
{% for cidr in avax_monitoring_allow %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    location = /ext/metrics { proxy_pass http://127.0.0.1:9650; proxy_set_header Host localhost; }
    location / { return 403; }
  }
}
