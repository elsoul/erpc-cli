[Unit]
Description=ERPC kaia confirmed firewall
DefaultDependencies=no
After=nftables.service
Before=network-pre.target shutdown.target erpc-kaia.service
Wants=network-pre.target
Conflicts=shutdown.target
RequiresMountsFor=/opt/erpc /etc/erpc/kaia

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ kaia_systemd_control }} firewall-load

[Install]
WantedBy=multi-user.target
