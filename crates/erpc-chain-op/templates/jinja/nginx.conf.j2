pid /run/erpc-{{ op_family }}-rpc/nginx.pid;
error_log stderr warn;
worker_processes 2;
events { worker_connections 4096; }
http {
  access_log off;
  client_max_body_size 8m;
  client_body_temp_path /run/erpc-{{ op_family }}-rpc/client;
  proxy_temp_path /run/erpc-{{ op_family }}-rpc/proxy;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen {{ '0.0.0.0' if op_rpc_allow else '127.0.0.1' }}:8555;
{% if op_rpc_v6 %}
    listen [::]:8555 ipv6only=on;
{% endif %}
    allow 127.0.0.1;
    allow ::1;
{% for cidr in op_rpc_allow %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    location / {
      proxy_pass http://127.0.0.1:8545;
      proxy_http_version 1.1;
      proxy_set_header Host localhost;
      proxy_set_header Authorization "";
      proxy_set_header Connection "";
      proxy_read_timeout 60s;
    }
  }
  server {
    listen {{ '0.0.0.0' if op_rpc_allow else '127.0.0.1' }}:8556;
{% if op_rpc_v6 %}
    listen [::]:8556 ipv6only=on;
{% endif %}
    allow 127.0.0.1;
    allow ::1;
{% for cidr in op_rpc_allow %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    location / {
      proxy_pass http://127.0.0.1:8546;
      proxy_http_version 1.1;
      proxy_set_header Host localhost;
      proxy_set_header Authorization "";
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
    }
  }
  server {
    listen {{ '0.0.0.0' if op_monitoring_allow else '127.0.0.1' }}:9060;
{% if op_monitoring_v6 %}
    listen [::]:9060 ipv6only=on;
{% endif %}
    allow 127.0.0.1;
    allow ::1;
{% for cidr in op_monitoring_allow %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    location = /execution { proxy_pass http://127.0.0.1:6060/metrics; }
    location = /consensus { proxy_pass http://127.0.0.1:7300/metrics; }
    location / { return 404; }
  }
}
