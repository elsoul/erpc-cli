[package]
name = "{{name}}"
version = "0.1.0"
description = "PumpSwap auto-trading bot via Geyser gRPC, run with erpc worker"
edition = "2021"
license = "Apache-2.0"
publish = false

[[bin]]
name = "{{name}}"
path = "src/main.rs"

[[bin]]
name = "notify-test"
path = "src/bin/notify_test.rs"

[dependencies]
anyhow = "1.0.62"
axum = "0.8"
backoff = { version = "0.4.0", features = ["tokio"] }
bs58 = "0.5.1"
chrono = { version = "0.4.38", features = ["serde"] }
dashmap = "5"
env_logger = "0.11.6"
futures = "0.3.31"
hex = "0.4.3"
home = "=0.5.11"
log = "0.4"
rand = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_jsonc = "1"
solana-account-decoder = "3.0"
solana-rpc-client = "3.0"
solana-rpc-client-api = "3.0"
solana-stream-sdk = { version = "3.0.0", default-features = false }
solana-sdk = "3.0"
solana-instruction = "3.0"
solana-commitment-config = "3.0"
solana-transaction-status = "3.0"
solana-pubkey = "3.0"
solana-signature = "3.0"
solana-hash = "3.0"
thiserror = "1"
tokio = { version = "1.48.0", features = ["rt-multi-thread", "macros"] }
tonic = { version = "0.14.2" }
# Pinned to a commit: a branch would build whatever it points at on the day.
ultima-swap-pumpfun = { git = "https://github.com/ValidatorsDAO/ultima", rev = "dbbe5f6e595369d12b8c30a58fc05a01126f4519" }
url = "2.5.4"
uuid = { version = "1", features = ["v4"] }
redis = { version = "0.27", features = ["tokio-comp", "aio"] }
# rustls, not the system's OpenSSL: the app cross-builds for Linux from any
# machine, and the binary needs no libssl on the server.
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
scalar_api_reference = { version = "0.2", features = ["axum"] }
utoipa = { version = "5", features = ["axum_extras"] }
zeroize = "1"
# Pin transitive deps to versions compatible with rust-toolchain 1.86.
time = "=0.3.44"
serde_with = "=3.16.1"
darling = "=0.21.3"

[target.'cfg(unix)'.dependencies]
libc = "0.2"

[workspace]
