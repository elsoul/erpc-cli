[Unit]
Description=Confirmed TRON firewall
DefaultDependencies=no
After=local-fs.target nftables.service
Before=network-pre.target shutdown.target tron-node.service
Wants=network-pre.target
Conflicts=shutdown.target
RequiresMountsFor=/opt/erpc /etc/erpc/tron

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/lib/erpc/rpc-firewall.py tron load

[Install]
WantedBy=multi-user.target

