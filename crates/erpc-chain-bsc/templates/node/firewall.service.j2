[Unit]
Description=ERPC bsc confirmed firewall
DefaultDependencies=no
After=nftables.service
Before=network-pre.target shutdown.target erpc-bsc.service
Wants=network-pre.target
Conflicts=shutdown.target
RequiresMountsFor=/opt/erpc /etc/erpc/bsc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ bsc_systemd_control }} firewall-load

[Install]
WantedBy=multi-user.target
