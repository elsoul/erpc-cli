[Unit]
Description=ERPC NEAR confirmed ingress policy
DefaultDependencies=no
After=nftables.service
Before=network-pre.target shutdown.target near-node.service
Wants=network-pre.target
Conflicts=shutdown.target
RequiresMountsFor=/opt/erpc /etc/erpc/near

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ near_systemd_control }} firewall-load

[Install]
WantedBy=multi-user.target
