{
  "version": "0.2.0",
  "tasks": {
    "check": "deno check --frozen-lockfile src/bin.ts src/index.ts test/*.test.ts",
    "test": "deno test --frozen-lockfile --allow-env --allow-net --allow-read --allow-run --allow-sys --allow-write test",
    "build": "deno compile --frozen-lockfile --allow-env --allow-net --allow-read --allow-write --allow-run --allow-sys --output dist/erpc src/bin.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "release:check": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task build"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/encoding/base64": "jsr:@std/encoding@1.0.11/base64",
    "@std/toml": "jsr:@std/toml@1.0.11"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "nodeModulesDir": "none",
  "fmt": {
    "exclude": [
      "examples/node-hono/pnpm-lock.yaml"
    ],
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-process-global",
        "require-await"
      ]
    }
  }
}
