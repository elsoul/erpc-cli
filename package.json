{
  "name": "@elsoul/erpc-cli",
  "version": "0.1.0",
  "description": "Command-line interface for ERPC Cloud",
  "keywords": [
    "cli",
    "cloud",
    "deploy",
    "erpc",
    "hono"
  ],
  "license": "MIT",
  "author": "ELSOUL LABO B.V.",
  "homepage": "https://erpc.global",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elsoul/erpc-cli.git"
  },
  "bugs": {
    "url": "https://github.com/elsoul/erpc-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "erpc": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "pack:check": "node scripts/verify-package.mjs && corepack pnpm pack --dry-run",
    "prepublishOnly": "corepack pnpm release:check",
    "release:check": "corepack pnpm check && corepack pnpm test && corepack pnpm build && node scripts/verify-package.mjs",
    "test": "vitest run --dir test"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
